# Local development only. Copy to .env; never commit real credentials.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=lcms
POSTGRES_PASSWORD=lcms_dev_password
POSTGRES_HOST_PORT=5434

# --- Mock CMS ---
MOCK_CMS_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/mock_cms
MOCK_CMS_TEST_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/mock_cms_test
MOCK_CMS_SESSION_TTL_MINUTES=480
MOCK_CMS_COOKIE_SECURE=false
# Password given to every seeded demo user (synthetic data only).
MOCK_CMS_SEED_PASSWORD=demo-password
