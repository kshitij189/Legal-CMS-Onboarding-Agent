# Local development only. Copy to .env; never commit real credentials.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=lcms
POSTGRES_PASSWORD=lcms_dev_password
POSTGRES_HOST_PORT=5434

# --- Mock CMS ---
MOCK_CMS_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/mock_cms
MOCK_CMS_TEST_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/mock_cms_test
MOCK_CMS_SESSION_TTL_MINUTES=480
MOCK_CMS_COOKIE_SECURE=false
# Password given to every seeded demo user (synthetic data only).
MOCK_CMS_SEED_PASSWORD=demo-password

# --- Onboarding backend ---
ONBOARDING_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/onboarding
ONBOARDING_TEST_DATABASE_URL=postgresql+psycopg://lcms:lcms_dev_password@localhost:5434/onboarding_test
# Comma-separated origins a CMS connector may target; anything else is rejected.
ONBOARDING_ALLOWED_CMS_ORIGINS=http://localhost:8100
ONBOARDING_ARTIFACTS_DIR=./artifacts
ONBOARDING_CMS_TIMEOUT_SECONDS=10
# Connector credentials, resolved from a connector's credential_ref (e.g. "firm-a-mock-cms").
# Use the mock CMS *integration* account (least privilege), never admin.
ONBOARDING_SECRET_FIRM_A_MOCK_CMS_USERNAME=a.integration
ONBOARDING_SECRET_FIRM_A_MOCK_CMS_PASSWORD=demo-password
ONBOARDING_SECRET_FIRM_B_MOCK_CMS_USERNAME=b.integration
ONBOARDING_SECRET_FIRM_B_MOCK_CMS_PASSWORD=demo-password
ONBOARDING_SECRET_FIRM_C_MOCK_CMS_USERNAME=c.integration
ONBOARDING_SECRET_FIRM_C_MOCK_CMS_PASSWORD=demo-password
ONBOARDING_TOKEN_TTL_MINUTES=480
# Self-service firm sign-up (POST /api/v1/firms). Set to false outside local demos.
ONBOARDING_ALLOW_SIGNUP=true
# Password for the seeded demo reviewers <a|b|c>.admin / <a|b|c>.specialist (python -m app.seed).
ONBOARDING_SEED_PASSWORD=demo-password
ONBOARDING_SEED_CMS_BASE_URL=http://localhost:8100
# Browser execution channel (Playwright): per-control wait and headless mode.
ONBOARDING_BROWSER_TIMEOUT_MS=5000
ONBOARDING_BROWSER_HEADLESS=true
# Mock CMS UI release: v1 (default) or v2 (renamed controls, for drift demos).
MOCK_CMS_UI_VARIANT=v1

# --- Durable runs (Phase 5) ---
# temporal: runs execute on the worker (docker compose up -d temporal worker); inline: in the API
# process (tests, environments without Temporal).
ONBOARDING_ORCHESTRATOR=temporal
ONBOARDING_TEMPORAL_ADDRESS=localhost:7234
ONBOARDING_TEMPORAL_NAMESPACE=default
ONBOARDING_TEMPORAL_TASK_QUEUE=onboarding-runs

# --- Tracing (OpenTelemetry) ---
# none | console | otlp. For otlp, start Jaeger: docker compose --profile observability up -d jaeger
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM providers (Phase 3). Put real keys only in the git-ignored .env ---
# Order of providers to try (D1 revised 2026-10-13): Groq first, Gemini as backup.
LLM_PROVIDERS=groq,gemini
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GROQ_API_KEY=
